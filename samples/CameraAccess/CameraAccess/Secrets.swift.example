// Copy this file to Secrets.swift and fill in your values.
// Secrets.swift is listed in .gitignore and is never committed.
//
// These are only starting values. Every one of them can also be entered
// later on the app's Settings screen, which takes priority.

import Foundation

enum Secrets {
  // REQUIRED for Gemini Live (the default provider).
  // Create a key at https://aistudio.google.com/apikey
  static let geminiAPIKey = "YOUR_GEMINI_API_KEY"

  // OPTIONAL: only if you want to use OpenAI instead of Gemini.
  // Create a key at https://platform.openai.com/api-keys (billed separately from ChatGPT).
  static let openAIAPIKey = "YOUR_OPENAI_API_KEY"

  // OPTIONAL: WebRTC signaling server URL for live point-of-view streaming to a browser.
  // Run: cd samples/CameraAccess/server && npm install && npm start
  static let webrtcSignalingURL = "ws://YOUR_MAC_IP:8080"
}
